# Required ---------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL=postgres://rootprint:rootprint@localhost:5432/rootprint

# Canonical public URL of this Rootprint instance. Used for the CORS allow-list
# and cookies.
# Local dev: http://localhost:5173 (Vite dev server with proxy).
# Production: your public HTTPS URL, e.g. https://logs.example.com.
ORIGIN=http://localhost:5173

# Tunda ------------------------------------------------------------------
#
# All required. This console authenticates nobody: every session comes from a
# Tunda authorization-code flow (ADR 0036, FORK.md). Without a configured issuer
# it has no authentication authority, so it refuses to start rather than serving
# requests it cannot safely answer — and it checks these before connecting to
# Postgres, so a missing one names itself instead of surfacing at the first
# sign-in.

# The tenant issuer this console is registered in — the COMPLETE issuer,
# exactly as it appears in a token's `iss` claim, not an origin. It is compared
# verbatim; the tenant id is read back out of it.
TUNDA_ISSUER=https://id.example.com/t/tnt_REPLACE_ME

# Optional. Where this console reaches Tunda for server-to-server calls — the
# token endpoint and the JWKS — when that differs from the public issuer above.
# Defaults to TUNDA_ISSUER.
#
# An issuer is an identifier; an endpoint is a location. In a mesh they differ,
# and routing the back channel through the public name puts egress, TLS
# termination and a public DNS lookup on the path that verifies every token.
# This never changes what `iss` must equal.
# TUNDA_INTERNAL_ISSUER=http://tunda-node.identity.svc/t/tnt_REPLACE_ME

# This console's registration. `private_key_jwt` is preferred by ADR 0036 and is
# not yet implemented on the Tunda side, so a secret it is for now.
TUNDA_CLIENT_ID=observability-console

# private_key_jwt — ADR 0036's preferred method, and the only one this console
# uses. There is no shared secret: a fresh, single-use assertion is signed per
# back-channel call, and Tunda holds only the public half of this key.
#
# The kid is sent in the assertion header so Tunda knows which registered key to
# check against, which is what lets a key be rotated in three deployments rather
# than one flag day.
#
# PKCS#8 PEM. Generate with:
#   openssl ecparam -name prime256v1 -genkey -noout |
#     openssl pkcs8 -topk8 -nocrypt -out console.pem
TUNDA_CLIENT_KEY_ID=console-key-1
TUNDA_CLIENT_PRIVATE_KEY=
TUNDA_AUDIENCE=https://observability.example.com
TUNDA_REDIRECT_URI=http://localhost:5173/api/auth/callback

# Which deployment this is, as a telemetry producer's token names its
# destinations: `signal:environment:index`. One of `production`, `staging`,
# `sandbox` — Tunda fixes that set in a check constraint, so any other value can
# never match a real grant and refuses every batch, silently from the producer's
# side.
TUNDA_ENVIRONMENT=production

# 32 bytes of base64, used to envelope-encrypt Tunda's tokens at rest:
#   openssl rand -base64 32
#
# NEVER generated by the console. A generated key would make every session on
# every other replica undecryptable and would rotate on each restart, which
# presents as "everybody is randomly signed out" rather than as a missing secret.
CONSOLE_SESSION_KEY=

# Quickwit REST endpoint.
QUICKWIT_URL=http://localhost:7280

# Optional ---------------------------------------------------------------

# Additional allowed CORS origin (for split SPA + API deployments where
# the SPA is hosted on a different origin from the API).
# FRONTEND_URL=

# Override the HTTP listen port. Default 8282.
# PORT=8282

# API log level. Supports Pino levels such as trace, debug, info, warn, error.
# LOG_LEVEL=info

# Number of trusted reverse proxies / load balancers in front of Rootprint
# that set X-Forwarded-For. Rate limits then key on the client IP read at that
# depth (e.g. 1 = a single nginx/Caddy in front; 2 = CDN + load balancer).
# Leave 0 (default) for direct exposure, where the TCP peer IP is used. Setting
# this higher than your real proxy count lets clients spoof XFF and forge keys.
# TRUST_PROXY_HOPS=0

# Rate limiting (in-memory, per-process). Window is shared by both limiters.
# PUBLIC_AUTH_RATE_LIMIT: requests per IP per window on the unauthenticated auth
# routes (/api/auth/login, /api/auth/step-up, /api/auth/callback). READ_RATE_LIMIT: requests per actor per window on search/histogram/
# field-values/share-resolve. Defaults shown.
# RATE_LIMIT_WINDOW_MS=60000
# PUBLIC_AUTH_RATE_LIMIT=30
# READ_RATE_LIMIT=300

# Number of days to retain search activity audit rows. The minimum and default
# are 30 days so the longest activity dashboard range remains complete.
# SEARCH_AUDIT_RETENTION_DAYS=30

# Google and GitHub OAuth: removed. This fork has one identity provider and it
# is Tunda. See FORK.md.

# Index holding OTLP spans. Every trace read and write resolves to this one index.
# Changing it is a data migration, not a toggle: existing spans are NOT moved, and the
# previous index becomes unreachable through the UI. Default shown.
# TRACE_INDEX_ID=otel-traces-v0_9
